      "title": "Final Scene",
      "status": "published",
      "teaser": null,
      "scenes": [
        {
          "id": "final-scene-1",
          "mood": "quiet-horizon",
          "video": "https://res.cloudinary.com/dofpspduc/video/upload/f_mp4,vc_h264,q_auto:eco,w_960,c_limit,ac_none,fps_24/v1786843265/final_scene_1_hwcnae.mp4",
          "image": null,
          "imageAlt": "An old man and his grown son sitting together in quiet, facing a wide horizon.",
          "blocks": [
            {
              "blockType": "text",
              "value": "Years later.",
              "speaker": null
            },
            {
              "blockType": "text",
              "value": "The boy is grown. The father is old. They’re sitting together somewhere quiet.",
              "speaker": null
            }
          ]
        },
        {
          "id": "final-scene-2",
          "mood": "quiet-horizon",
          "video": "https://res.cloudinary.com/dofpspduc/video/upload/f_mp4,vc_h264,q_auto:eco,w_960,c_limit,ac_none,fps_24/v1786843265/final_scene_2_owet6m.mp4",
          "image": null,
          "imageAlt": "The grown son turning to ask his father a question, the horizon behind them.",
          "blocks": [
            {
              "blockType": "dialogue",
              "value": "Dad, were you ever afraid of bringing us into this world?",
              "speaker": "The son"
            },
            {
              "blockType": "dialogue",
              "value": "More than you know.",
              "speaker": "The father"
            }
          ]
        },
        {
          "id": "final-scene-3",
          "mood": "quiet-horizon",
          "video": "https://res.cloudinary.com/dofpspduc/video/upload/f_mp4,vc_h264,q_auto:eco,w_960,c_limit,ac_none,fps_24/v1786843265/final_scene_3_utsv9t.mp4",
          "image": null,
          "imageAlt": "The old father looking toward the horizon as he answers.",
          "blocks": [
            {
              "blockType": "dialogue",
              "value": "Why?",
              "speaker": "The son"
            },
            {
              "blockType": "text",
              "value": "He looks toward the horizon.",
              "speaker": null
            },
            {
              "blockType": "dialogue",
              "value": "Because I thought my job was to protect you from the darkness of the world.",
              "speaker": "The father"
            }
          ]
        },
        {
          "id": "final-scene-4",
          "mood": "quiet-horizon",
          "video": "https://res.cloudinary.com/dofpspduc/video/upload/f_mp4,vc_h264,q_auto:eco,w_960,c_limit,ac_none,fps_24/v1786843265/final_scene_4_hvuoxb.mp4",
          "image": null,
          "imageAlt": "A quiet pause between father and son, neither speaking.",
          "blocks": [
            {
              "blockType": "text",
              "value": "A pause.",
              "speaker": null
            },
            {
              "blockType": "dialogue",
              "value": "Then I realized that wasn’t possible.",
              "speaker": "The father"
            },
            {
              "blockType": "dialogue",
              "value": "So what did you do?",
              "speaker": "The son"
            }
          ]
        },
        {
          "id": "final-scene-5",
          "mood": "quiet-horizon",
          "video": "https://res.cloudinary.com/dofpspduc/video/upload/f_mp4,vc_h264,q_auto:eco,w_960,c_limit,ac_none,fps_24/v1786843265/final_scene_5_yct4as.mp4",
          "image": null,
          "imageAlt": "The son taking his old father’s hand.",
          "blocks": [
            {
              "blockType": "dialogue",
              "value": "I tried to make sure that whatever darkness reached you... you didn’t have to face it alone.",
              "speaker": "The father"
            },
            {
              "blockType": "text",
              "value": "The son takes his father’s hand.",
              "speaker": null
            }
          ]
        },
        {
          "id": "final-scene-6",
          "mood": "quiet-horizon",
          "video": "https://res.cloudinary.com/dofpspduc/video/upload/f_mp4,vc_h264,q_auto:eco,w_960,c_limit,ac_none,fps_24/v1786843265/final_scene_6_gsh4pq.mp4",
          "image": null,
          "imageAlt": "The two of them, small against the wide, quiet horizon.",
          "blocks": [
            {
              "blockType": "text",
              "value": "He never needed to solve life.",
              "speaker": null
            },
            {
              "blockType": "text",
              "value": "He never needed to understand why humanity exists.",
              "speaker": null
            },
            {
              "blockType": "text",
              "value": "He never needed to create a perfect world for his children.",
              "speaker": null
            },
            {
              "blockType": "text",
              "value": "He only needed to love them while they were here. And perhaps that was enough.",
              "speaker": null
            }
          ]
        },
        {
          "id": "final-scene-7",
          "mood": "quiet-house",
          "video": "https://res.cloudinary.com/dofpspduc/video/upload/f_mp4,vc_h264,q_auto:eco,w_960,c_limit,ac_none,fps_24/v1786843265/final_scene_7.2_viocgb.mp4",
          "image": null,
          "imageAlt": "A tiny insect crossing the railing beside the old man and his son, echoing the story’s opening.",
          "blocks": [
            {
              "blockType": "text",
              "value": "Then something small catches the son’s eye — an insect, crossing the railing beside them.",
              "speaker": null
            },
            {
              "blockType": "dialogue",
              "value": "Dad. Look.",
              "speaker": "The son"
            },
            {
